{
  "name": "mango-farm-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts",
    "deploy:staging": "wrangler deploy --env staging --minify",
    "deploy:production": "wrangler deploy --env production --minify",
    "deploy": "npm run deploy:staging"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "mango-farm-authorization": "*",
    "mango-farm-database": "*",
    "postgres": "^3.4.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "wrangler": "^4.113.0"
  }
}
