{
  "name": "mango-farm-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-local-api.mjs",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts",
    "deploy:staging": "wrangler deploy --env staging --minify",
    "deploy:production": "wrangler deploy --env production --minify",
    "deploy": "npm run deploy:staging"
  },
  "dependencies": {
    "hono": "^4.13.20",
    "jose": "^6.2.18",
    "mango-farm-authorization": "*",
    "mango-farm-database": "*",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "wrangler": "4.153.0"
  }
}
