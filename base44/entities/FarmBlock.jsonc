{
  "name": "FarmBlock",
  "type": "object",
  "properties": {
    "farm_id": { "type": "string", "title": "Farm ID" },
    "farm_name": { "type": "string", "title": "Farm Name" },
    "block_code": { "type": "string", "title": "Block Code" },
    "name": { "type": "string", "title": "Block Name" },
    "description": { "type": ["string", "null"], "title": "Description" },
    "early_block_classification": {
      "type": ["string", "null"],
      "title": "Early Block",
      "enum": ["Yes", "Mid", "New", null]
    },
    "year_planted": { "type": ["number", "null"], "title": "Year Planted" },
    "area_acres": { "type": ["number", "null"], "title": "Acres" },
    "shoot_maturity": { "type": "number", "title": "Maturity", "minimum": 0, "maximum": 1 },
    "forecast_yield_kg": { "type": ["number", "null"], "title": "Forecasted Yield (KG)" },
    "actual_yield_kg": { "type": ["number", "null"], "title": "Actual Yield (KG)" },
    "fruit_fly_pressure": { "type": ["string", "null"], "title": "Fruit Flies" },
    "disease_rating": { "type": ["string", "null"], "title": "Disease" },
    "latitude": { "type": "number", "title": "Latitude" },
    "longitude": { "type": "number", "title": "Longitude" },
    "tree_count": { "type": "number", "title": "Tree Count", "default": 0 },
    "planting_year": { "type": "number", "title": "Planting Year" },
    "farming_stage": {
      "type": "string",
      "title": "Current Farming Stage",
      "enum": ["harvesting", "pruning", "fertilizer_application", "flower_induction", "fruiting", "pest_control", "irrigation", "dormant", "land_preparation"]
    },
    "mango_variety": { "type": "string", "title": "Mango Variety" },
    "disease_severity": { "type": ["string", "null"], "title": "Disease Severity" },
    "soil_condition": { "type": "string", "title": "Soil Condition" },
    "irrigation_status": { "type": "string", "title": "Irrigation Status" },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": ["active", "inactive", "merged", "archived"],
      "default": "active"
    }
  },
  "required": ["farm_id", "block_code", "name"]
}
