{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "vehicle_code": {
      "type": "string",
      "title": "Vehicle Code"
    },
    "plate_number": {
      "type": "string",
      "title": "Plate Number"
    },
    "vehicle_type": {
      "type": "string",
      "title": "Vehicle Type",
      "enum": [
        "truck",
        "van",
        "pickup",
        "trailer",
        "refrigerated_truck"
      ],
      "default": "truck"
    },
    "capacity_kg": {
      "type": "number",
      "title": "Capacity (kg)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "maintenance",
        "retired"
      ],
      "default": "active"
    },
    "driver_name": {
      "type": "string",
      "title": "Assigned Driver"
    },
    "insurance_expiry": {
      "type": "string",
      "title": "Insurance Expiry",
      "format": "date"
    },
    "last_service_date": {
      "type": "string",
      "title": "Last Service Date",
      "format": "date"
    }
  },
  "required": [
    "vehicle_code",
    "plate_number"
  ]
}