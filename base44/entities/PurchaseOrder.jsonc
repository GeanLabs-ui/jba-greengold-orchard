{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "title": "PO Number"
    },
    "supplier_id": {
      "type": "string",
      "title": "Supplier ID"
    },
    "supplier_name": {
      "type": "string",
      "title": "Supplier Name"
    },
    "order_date": {
      "type": "string",
      "title": "Order Date",
      "format": "date"
    },
    "expected_delivery_date": {
      "type": "string",
      "title": "Expected Delivery",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "sent",
        "partially_received",
        "received",
        "cancelled"
      ],
      "default": "draft"
    },
    "line_items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "vat_amount": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "vat_amount": {
      "type": "number",
      "title": "VAT",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "po_number",
    "supplier_id",
    "order_date"
  ]
}