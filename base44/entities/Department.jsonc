{
  "name": "Department",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Department Name"
    },
    "code": {
      "type": "string",
      "title": "Department Code"
    },
    "parent_department_id": {
      "type": "string",
      "title": "Parent Department ID"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive"],
      "default": "active"
    }
  },
  "required": ["name", "code"]
}
