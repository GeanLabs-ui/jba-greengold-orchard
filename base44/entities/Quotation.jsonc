{
  "name": "Quotation",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "title": "Quote Number"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "quote_date": {
      "type": "string",
      "title": "Quote Date",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "title": "Valid Until",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "rejected",
        "expired",
        "converted"
      ],
      "default": "draft"
    },
    "line_items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "discount_amount": {
            "type": "number"
          },
          "vat_amount": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount",
      "default": 0
    },
    "vat_amount": {
      "type": "number",
      "title": "VAT",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "quote_number",
    "customer_id",
    "quote_date"
  ]
}