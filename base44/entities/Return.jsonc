{
  "name": "Return",
  "type": "object",
  "properties": {
    "return_number": {
      "type": "string",
      "title": "Return Number"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "invoice_id": {
      "type": "string",
      "title": "Invoice ID"
    },
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number"
    },
    "return_date": {
      "type": "string",
      "title": "Return Date",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "requested",
        "approved",
        "rejected",
        "processed"
      ],
      "default": "requested"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "total_amount": {
      "type": "number",
      "title": "Total Amount",
      "default": 0
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "return_number",
    "customer_id",
    "return_date"
  ]
}