{
  "name": "mango-farm-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "predev:all": "npm run db:migrate",
    "dev:all": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w apps/web -- --host 127.0.0.1",
    "build": "npm run build:web && npm run typecheck:api",
    "build:web": "npm run build -w apps/web",
    "lint": "npm run lint:web",
    "lint:web": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck:web && npm run typecheck:api && npm run typecheck:packages",
    "typecheck:web": "npm run typecheck -w apps/web",
    "typecheck:api": "npm run typecheck -w apps/api",
    "typecheck:packages": "npx tsc -p packages/database/tsconfig.json --noEmit && npx tsc -p packages/authorization/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:web",
    "dev:api": "npm run dev -w apps/api",
    "db:migrate": "node --env-file-if-exists=.env packages/database/scripts/migrate.mjs",
    "db:check-migrations": "node packages/database/scripts/check-migrations.mjs",
    "db:inspect": "node --env-file-if-exists=.env scripts/inspect-database.mjs",
    "db:consolidate:local": "node --env-file-if-exists=.env scripts/consolidate-local-databases.mjs",
    "deploy:verify": "node scripts/verify-deployment-config.mjs",
    "admin:promote": "node --env-file-if-exists=.env scripts/promote-admin.mjs",
    "deploy:api:staging": "npm run deploy:staging -w apps/api",
    "deploy:api:production": "npm run deploy:production -w apps/api",
    "deploy:pages:staging": "wrangler pages deploy apps/web/dist --project-name=jba-greengold-orchard --branch=staging",
    "deploy:pages:production": "wrangler pages deploy apps/web/dist --project-name=jba-greengold-orchard --branch=main",
    "assets:optimize": "node scripts/optimize-images.mjs"
  },
  "devDependencies": {
    "brace-expansion": "1.1.18",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "0.25.12",
    "js-yaml": "4.3.1",
    "sharp": "^0.35.3",
    "vitest": "^4.0.0",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "dompurify": "^3.4.13",
    "js-yaml": "$js-yaml",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "$sharp",
    "vite": {
      "esbuild": "0.25.12"
    }
  }
}
